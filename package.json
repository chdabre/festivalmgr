{
  "name": "festivalmgr",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n nuxt,emu \"nuxt dev\" \"firebase emulators:start --import=./.emulator-data --export-on-exit\"",
    "dev:seed": "tsx scripts/seed-emulator.ts",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck && pnpm --filter ./functions typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:functions": "pnpm --filter ./functions test",
    "seed:director": "tsx scripts/seed-director.ts"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.0.0",
    "@nuxtjs/i18n": "^10.3.0",
    "@vue/test-utils": "^2.4.10",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "firebase-tools": "^15.17.0",
    "happy-dom": "^20.9.0",
    "nuxt": "^4.4.4",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@nuxt/ui": "^4.7.1",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.9.0",
    "firebase-functions": "^7.2.5",
    "nuxt-vuefire": "^1.1.2",
    "tailwindcss": "^4.2.4"
  }
}
