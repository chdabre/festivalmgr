{
  "name": "festivalmgr",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter ./functions build && concurrently -k -n emu,fn,nuxt \"firebase emulators:start --project=demo-festivalmgr-dev --import=./.emulator-data --export-on-exit\" \"pnpm --filter ./functions build:watch\" \"node scripts/wait-for-emulators.mjs && nuxt dev\"",
    "dev:seed": "tsx scripts/seed-emulator.ts",
    "rules:compose": "tsx scripts/compose-rules.ts",
    "rules:test": "vitest run --config vitest.config.rules.ts",
    "rules:check": "pnpm rules:compose && firebase emulators:exec --only firestore,storage --project=demo-festivalmgr-rules-test 'pnpm rules:test'",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck && pnpm --filter ./functions typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:functions": "pnpm --filter ./functions test",
    "seed:director": "tsx scripts/seed-director.ts"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@nuxt/eslint": "^1.0.0",
    "@nuxtjs/i18n": "^10.3.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.10",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "firebase-tools": "^15.17.0",
    "happy-dom": "^20.9.0",
    "nuxt": "^4.4.4",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.34",
    "vue-tsc": "^3.2.8",
    "vuefire": "^3.2.3"
  },
  "dependencies": {
    "@nuxt/ui": "^4.7.1",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.9.0",
    "firebase-functions": "^7.2.5",
    "nuxt-vuefire": "^1.1.2",
    "tailwindcss": "^4.2.4"
  }
}
